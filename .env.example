# Copy to .env and adjust. Every value is optional.

# Where the server listens. Keep 127.0.0.1 unless the overlay runs on another machine.
PORT=4747
HOST=127.0.0.1

# Folder for config.json and session.json (defaults to ./data).
# FINWHEEL_DATA_DIR=./data

# Shared secret required to control the wheel (dock, HTTP API, OBS script).
# Strongly recommended when HOST is not 127.0.0.1. Open the dock with /dock/?token=<value>.
# FINWHEEL_TOKEN=

# Extra origins allowed to control the server, comma separated.
# FINWHEEL_ALLOWED_ORIGINS=

# Optional Twitch account used to announce results in chat.
# Reading chat needs no credentials; set the channel in the dock's Settings tab.
# TWITCH_BOT_USERNAME=
# The token alone (the oauth: prefix is optional), see README step 5.
# TWITCH_OAUTH_TOKEN=
